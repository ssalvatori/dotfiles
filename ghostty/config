# Config generated by Ghostty Config

shell-integration = "zsh"

clipboard-read = allow
clipboard-write = allow
copy-on-select = true

# background-opacity = 0.90

#:theme = "/users/stefano/.local/share/nvim/lazy/tokyonight.nvim/extras/ghostty/tokyonight_storm"
# window-decoration = none

# font-family = "FiraCode Nerd Font"
font-family = "MesloLGS NF"
font-size = 14.5

# Cursor preferences
cursor-style = "block"
cursor-style-blink = true
# shell-integration-features = "no-cursor" #  Hide cursor during shell integration animations


# theme = catppuccin-mocha

# adjust-cell-height = 10%
#command = /bin/zsh -c "tmux new -A -s work"
mouse-hide-while-typing = true
# macos-non-native-fullscreen=visible-menu
# macos-option-as-alt = true
# macos-titlebar-style = hidden
#
shell-integration-features = ssh-terminfo,ssh-env
keybind = global:cmd+backquote=toggle_quick_terminal

theme = dark:Rose Pine,light:Rose Pine Moon

# Prevents Ghostty from trying to resize the window in 'steps' 
# This makes it play much nicer with tiling window managers.
window-step-resize = false

# Correct key for always showing the tab bar
window-show-tab-bar = always
